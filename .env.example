# CirrhosisRegistry — environment configuration template
# Copy this file to .env and adjust values as needed.
# All variables have sensible defaults; only change what differs from your setup.
#
# IMPORTANT: .env is for local development only. Never commit it to version control.

# ── LLM (local / institutional only — public cloud APIs are refused) ──────────
LLM_PROVIDER=ollama                        # ollama | llamacpp | disabled
LLM_BASE_URL=http://127.0.0.1:11434        # Ollama default; use :8000 for llama.cpp
LLM_ALLOWED_HOSTS=                         # comma-separated institutional hosts on public IPs (private/loopback need no entry)
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M      # recommended; Ollama "-cloud" models are refused
LLM_CONTEXT_LIMIT=24000                    # not used yet
LLM_MAX_RETRIES=2                          # enum validation retries per LLM call
ENABLE_LLM=true                            # false = no run may use the LLM (the UI switch cannot override it)
ENABLE_LLM_CACHE=true                      # per-job in-memory prompt cache; false e.g. for benchmark runs
# Temperature (0.0), max_tokens (1000) and the 300 s call timeout are fixed in
# app/services/llm_client.py; the UI panel and <case_id>_run_config.json show them.

# ── Job queue ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Flask ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-local-only
FLASK_ENV=development
MAX_UPLOAD_MB=200

# ── Paths ──────────────────────────────────────────────────────────────────────
UPLOAD_FOLDER=data/uploads
OUTPUT_FOLDER=data/out
JOBS_FOLDER=data/jobs
REGISTRY_PATH=config/Registry_base.xlsx
